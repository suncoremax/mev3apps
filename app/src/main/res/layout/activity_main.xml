<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:keepScreenOn="true">

    <!-- ===== Top HUD bar ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/shape_panel"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_status_dot" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_disconnected"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_thrust_cap"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <SeekBar
            android:id="@+id/thrustCapSeek"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80"
            android:progressTint="@color/accent_orange"
            android:thumbTint="@color/accent_orange" />

        <TextView
            android:id="@+id/thrustCapValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textColor="@color/accent_orange"
            android:textStyle="bold"
            android:gravity="end"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/btn_settings"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <!-- ===== Left stick: throttle (Y, no auto-center) / yaw (X) ===== -->
    <TextView
        android:id="@+id/labelLeftStick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_throttle"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="@id/leftStick"
        app:layout_constraintEnd_toEndOf="@id/leftStick"
        app:layout_constraintBottom_toTopOf="@id/leftStick" />

    <com.axiion.dronecontrol.JoystickView
        android:id="@+id/leftStick"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="20dp"
        app:autoCenterX="true"
        app:autoCenterY="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ===== Right stick: roll (X) / pitch (Y), both self-center ===== -->
    <TextView
        android:id="@+id/labelRightStick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_roll_pitch"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="@id/rightStick"
        app:layout_constraintEnd_toEndOf="@id/rightStick"
        app:layout_constraintBottom_toTopOf="@id/rightStick" />

    <com.axiion.dronecontrol.JoystickView
        android:id="@+id/rightStick"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        app:autoCenterX="true"
        app:autoCenterY="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ===== Center console: arm state, ARM/DISARM, STOP ===== -->
    <LinearLayout
        android:id="@+id/centerConsole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toEndOf="@id/leftStick"
        app:layout_constraintEnd_toStartOf="@id/rightStick"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintVertical_bias="0.55">

        <TextView
            android:id="@+id/armStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_disarmed"
            android:textColor="@color/accent_red"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.06"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/thrustReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnArm"
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:background="@drawable/shape_btn_arm"
            android:text="@string/btn_arm"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:elevation="4dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/shape_btn_stop"
            android:text="@string/btn_stop"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- ===== First-run WiFi hint banner ===== -->
    <TextView
        android:id="@+id/wifiHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_panel"
        android:text="@string/wifi_hint"
        android:textColor="@color/accent_yellow"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
