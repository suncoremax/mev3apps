<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/green_bright"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_sub"
                android:textColor="@color/sub"
                android:textSize="10sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/connPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/connDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_swatch"
                android:backgroundTint="@color/red" />

            <TextView
                android:id="@+id/connLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_connected"
                android:textColor="@color/txt"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Tabs ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        android:weightSum="3">

        <Button
            android:id="@+id/tabPicture"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/tab_picture"
            android:background="@drawable/bg_tab_active_green"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/tabText"
            style="@style/TabButton"
            android:layout_marginHorizontal="3dp"
            android:text="@string/tab_text" />

        <Button
            android:id="@+id/tabBillboard"
            style="@style/TabButton"
            android:layout_marginStart="6dp"
            android:text="@string/tab_billboard" />
    </LinearLayout>

    <!-- ── Content ────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/panelPicture"
            layout="@layout/panel_picture" />

        <include
            android:id="@+id/panelText"
            layout="@layout/panel_text"
            android:visibility="gone" />

        <include
            android:id="@+id/panelBillboard"
            layout="@layout/panel_billboard"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
